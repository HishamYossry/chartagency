# Website settings. Read when the server starts — to move from the temporary domains
# to the real ones, change these (here or in hPanel's Node.js environment variables)
# and restart. No rebuild needed.

# The admin panel / API (Laravel): page content, uploaded images, and the lead form.
CMS_API_URL=https://admin.chartagencydemo.com

# This website's own address (canonical links and social previews).
SITE_URL=https://chartagencydemo.com

# Long random string. Must equal FRONTEND_REVALIDATE_SECRET in the admin's .env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=change-me
